{
  "name": "dotfile-toggle",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "publisher": "EnlightenedSolutionsLLC",
  "displayName": "Dotfile Toggle",
  "description": "Toggle visibility of dotfiles in the Explorer",
  "version": "0.0.4",
  "engines": {
    "vscode": ">=1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dotfiles",
    "files",
    "explorer",
    "toggle",
    "visibility",
    "hidden"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CatDogBark/dotfile-toggle"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dotfileToggle.toggle"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dotfileToggle.toggle",
        "title": "Toggle Dotfiles",
        "icon": "$(eye)"
      },
      {
        "command": "dotfileToggle.hide",
        "title": "Hide Dotfiles",
        "icon": "$(eye)"
      },
      {
        "command": "dotfileToggle.show",
        "title": "Show Dotfiles",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dotfileToggle.hide",
          "when": "view == workbench.explorer.fileView && !dotfileToggle.hidden",
          "group": "navigation"
        },
        {
          "command": "dotfileToggle.show",
          "when": "view == workbench.explorer.fileView && dotfileToggle.hidden",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dotfileToggle.toggle"
        },
        {
          "command": "dotfileToggle.hide",
          "when": "false"
        },
        {
          "command": "dotfileToggle.show",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Dotfile Toggle",
      "properties": {
        "dotfileToggle.hideDotfiles": {
          "type": "boolean",
          "default": false,
          "description": "Hide files starting with a dot"
        },
        "dotfileToggle.notify": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification each time dotfiles are hidden or shown"
        }
      }
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x"
  }
}
